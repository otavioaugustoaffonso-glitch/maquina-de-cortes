# =============================================================================
# Máquina de Cortes — variáveis de ambiente
# Copie para .env.local (Next.js) e .env (worker). NUNCA faça commit dos valores reais.
# Variáveis NEXT_PUBLIC_* vão para o navegador — só coloque ali o que é público.
# =============================================================================

# --- Supabase (https://supabase.com/dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave pública "anon" (protegida por RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SECRETA: apenas servidor/worker

# URL pública do app (links de confirmação de e-mail / recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Limites (servidor) ---
MAX_UPLOAD_BYTES=5368709120                     # 5 GB
MAX_CONCURRENT_VIDEOS=3                         # vídeos em processamento por usuário

# --- Transcrição: openai | groq | mock ---
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=sk-...                           # https://platform.openai.com/api-keys
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# GROQ_API_KEY=gsk_...                          # https://console.groq.com/keys
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Análise dos cortes (LLM): anthropic | heuristic ---
ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...                    # https://console.anthropic.com/settings/keys
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high                           # low | medium | high | xhigh | max

# --- Worker ---
WORKER_CONCURRENCY=1                            # jobs simultâneos por instância
WORKER_POLL_INTERVAL_MS=2000
# WORKER_TMP_DIR=/tmp/maquina-de-cortes
# WORKER_FONTS_DIR=./worker/fonts
# PYTHON_BIN=python3
X264_PRESET=medium                              # ultrafast..veryslow (qualidade x velocidade)
X264_CRF=20
PROXY_ENABLED=true                              # preview 540p para o editor
FACE_TRACKING=true                              # enquadramento automático no rosto
MAX_AUTO_RENDER=30                              # cortes renderizados automaticamente por vídeo
MAX_VIDEO_SECONDS=14400                         # 4 h
ENFORCE_CREDITS=false                           # true = debita profiles.credits_seconds
EXPORT_TTL_DAYS=7
LOG_LEVEL=info

# =============================================================================
# Máquina de Cortes — variáveis de ambiente (100% gratuito)
# Copie para .env.local (Next.js) e .env (worker). NUNCA faça commit dos valores reais.
# Variáveis NEXT_PUBLIC_* vão para o navegador — só coloque ali o que é público.
# O projeto só contém provedores gratuitos: open source local ou plano gratuito sem cartão.
# =============================================================================

# --- Supabase LOCAL (open source, roda no Docker) ---
# `npx supabase start` imprime a URL e as chaves abaixo.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave pública "anon" (protegida por RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SECRETA: apenas servidor/worker
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Limites ---
MAX_UPLOAD_BYTES=5368709120                     # 5 GB
MAX_CONCURRENT_VIDEOS=3

# --- Transcrição: local (faster-whisper, padrão) | groq (plano gratuito, opcional) ---
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small                       # tiny | base | small | medium | large-v3-turbo
LOCAL_WHISPER_DEVICE=cpu                        # cpu | cuda (GPU NVIDIA)
LOCAL_WHISPER_COMPUTE=int8
# GROQ_API_KEY=gsk_...                          # https://console.groq.com/keys — NÃO cadastre cartão

# --- Análise dos cortes: heuristic (padrão) | ollama (recomendado) | openai-compatible
#                         | gemini | groq (planos gratuitos, opcionais) ---
ANALYSIS_PROVIDER=heuristic
# LLM_MODEL=qwen2.5:7b                          # modelo do Ollama (ou de outro provedor)
# LLM_BASE_URL=http://localhost:11434/v1        # ollama / openai-compatible
# ANALYSIS_MAX_CHARS=24000                      # tamanho da transcrição por chamada
# GEMINI_API_KEY=...                            # https://aistudio.google.com/apikey — NÃO ative faturamento

# --- Worker ---
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
X264_PRESET=veryfast                            # mais rápido = menos CPU
X264_CRF=21
PROXY_ENABLED=true
FACE_TRACKING=true
MAX_AUTO_RENDER=10
MAX_VIDEO_SECONDS=7200
ENFORCE_CREDITS=false
EXPORT_TTL_DAYS=3
LOG_LEVEL=info

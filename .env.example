# =============================================================================
# Máquina de Cortes — variáveis de ambiente
# Copie para .env.local (Next.js) e .env (worker). NUNCA faça commit dos valores reais.
# Variáveis NEXT_PUBLIC_* vão para o navegador — só coloque ali o que é público.
#
# PADRÃO = CUSTO ZERO. Provedores pagos (OpenAI, Anthropic) ficam BLOQUEADOS
# até você definir ALLOW_PAID_PROVIDERS=true. Veja docs/CUSTOS.md.
# =============================================================================

# --- Supabase ---
# Local (grátis): `npx supabase start` imprime a URL e as chaves abaixo.
# Hospedado: https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave pública "anon"/"publishable" (protegida por RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SECRETA: apenas servidor/worker
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Limites ---
MAX_UPLOAD_BYTES=5368709120                     # 5 GB (no Supabase Free HOSPEDADO o limite real é 50 MB por arquivo)
MAX_CONCURRENT_VIDEOS=3

# --- Trava de custo ---
ALLOW_PAID_PROVIDERS=false                      # true = autoriza OpenAI/Anthropic (geram cobrança)

# --- Transcrição: local (grátis) | groq (plano gratuito) | openai (pago) ---
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small                       # tiny | base | small | medium | large-v3-turbo
LOCAL_WHISPER_DEVICE=cpu                        # cpu | cuda
LOCAL_WHISPER_COMPUTE=int8
# GROQ_API_KEY=gsk_...                          # https://console.groq.com/keys (não cadastre cartão para ficar no gratuito)
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=sk-...                         # pago — requer ALLOW_PAID_PROVIDERS=true

# --- Análise dos cortes: heuristic (grátis) | gemini | groq (planos gratuitos) | ollama (grátis, local)
#                         | openai-compatible | anthropic (pago) ---
ANALYSIS_PROVIDER=heuristic
# GEMINI_API_KEY=...                            # https://aistudio.google.com/apikey (sem ativar faturamento)
# LLM_MODEL=gemini-2.5-flash                    # sobrescreve o modelo padrão do provedor
# LLM_BASE_URL=http://localhost:11434/v1        # ollama / openai-compatible
# ANALYSIS_MAX_CHARS=16000                      # tamanho da janela de transcrição por chamada
# ANTHROPIC_API_KEY=sk-ant-...                  # pago — requer ALLOW_PAID_PROVIDERS=true
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# --- Worker ---
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
X264_PRESET=veryfast                            # mais rápido = menos CPU
X264_CRF=21
PROXY_ENABLED=true
FACE_TRACKING=true
MAX_AUTO_RENDER=10                              # menos cortes renderizados automaticamente = menos CPU/armazenamento
MAX_VIDEO_SECONDS=7200
ENFORCE_CREDITS=false
EXPORT_TTL_DAYS=3
LOG_LEVEL=info
